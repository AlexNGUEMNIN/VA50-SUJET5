<?xml version="1.0"?>
<package format="2">
  <name>huggingface_bridge</name>
  <version>1.0.0</version>
  <description>
    ROS bridge pour la communication entre le robot Tiago et les modèles Hugging Face.
    Permet le traitement d'images pour le réarrangement autonome d'objets.
  </description>

  <maintainer email="alex.nguemnin@example.com">AlexNGUEMNIN</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>rospy</build_depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>

  <export>
  </export>
</package>
