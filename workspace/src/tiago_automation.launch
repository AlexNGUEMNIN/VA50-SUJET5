<?xml version="1.0" encoding="UTF-8"?>
<!--
===============================================================================
 🤖 TIAGO AUTOMATION LAUNCH FILE
===============================================================================
 
 Ce fichier launch orchestre le pipeline complet de réarrangement d'objets :
 
    - Option 1: Lancer le pipeline complet (capture + IA + commande)
    - Option 2: Lancer uniquement une étape spécifique
 
 Usage (depuis le répertoire workspace):
    roslaunch workspace/src/tiago_automation.launch
    roslaunch workspace/src/tiago_automation.launch mode:=capture
    roslaunch workspace/src/tiago_automation.launch mode:=pipeline
    roslaunch workspace/src/tiago_automation.launch mode:=command
    roslaunch workspace/src/tiago_automation.launch wait_for_gazebo:=false
 
 Ou en utilisant le chemin complet:
    roslaunch ~/ros_ws/workspace/src/tiago_automation.launch
 
 Auteur : R3 - Ingénieur Logiciel & Intégration
 Projet : VA50 - Vision Artificielle et Systèmes Autonomes
===============================================================================
-->
<launch>
    <!-- ================================================================== -->
    <!-- ARGUMENTS -->
    <!-- ================================================================== -->
    
    <!-- Mode d'exécution: full, capture, pipeline, command -->
    <arg name="mode" default="full" 
         doc="Mode d'exécution: full (complet), capture, pipeline, command"/>
    
    <!-- Attendre que Gazebo soit prêt -->
    <arg name="wait_for_gazebo" default="true"
         doc="Attendre que les topics Gazebo soient disponibles"/>
    
    <!-- Chemin du workspace -->
    <arg name="workspace_path" default="$(env HOME)/ros_ws/workspace"
         doc="Chemin vers le workspace ROS"/>

    <!-- ================================================================== -->
    <!-- NŒUD D'AUTOMATISATION -->
    <!-- ================================================================== -->
    
    <!-- Utilisation du type "python3" avec le chemin absolu du script -->
    <node name="tiago_automation_node"
          pkg="roslaunch"
          type="roslaunch"
          output="screen"
          required="true"
          respawn="false"
          args="--wait">
        
        <!-- Le script sera lancé manuellement, ce launch file sert de template -->
        
    </node>

</launch>

<!--
===============================================================================
 NOTE: Pour une utilisation simple, préférez lancer le script directement:
 
    cd ~/ros_ws/workspace/scripts
    python3 automation_node.py
 
 Ce fichier launch est fourni comme référence et template pour une intégration
 future dans un package ROS complet.
===============================================================================
-->
